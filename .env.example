# ==============================================================================
# Berean Standard Bible (BSB) Hybrid RAG System — Configuration (.env.example)
# ==============================================================================

# --- LLM Provider & Minimal-Effort Settings ---
# Supported providers: openai | anthropic | ollama
LLM_PROVIDER=openai
# empty = provider default (see `DEFAULT_MODELS`: openai -> gpt-4o-mini, anthropic -> claude-haiku-5-5)
LLM_MODEL=
LLM_EFFORT=minimal
LLM_TEMPERATURE=0.0

# API Keys (set at least the one matching your provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Dense & Sparse Embedding Settings ---
# Supported dense providers: fastembed | openai | auto
# "auto" is discouraged: it uses OpenAI (1536-dim) when OPENAI_API_KEY is present and
# local FastEmbed (384-dim) otherwise, so adding an API key later (e.g. for the LLM)
# silently changes vector dimensions and breaks every query against an existing collection.
EMBEDDING_PROVIDER=fastembed
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FASTEMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_SPARSE_MODEL=Qdrant/bm25

# --- Qdrant Vector Database Settings ---
# Mode: memory | local | remote
QDRANT_MODE=remote
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=bsb_rag

# --- Reranker & Retrieval Settings ---
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RETRIEVAL_INITIAL_K=25
RETRIEVAL_TOP_K=6

# --- Citation Validation ---
# annotate: report valid/partial/unsupported citations only (default)
# strict: also strip unsupported citations; LLM answers left with none become insufficient-context
# CITATION_POLICY=annotate

# --- API Concurrency, Authentication, Rate Limits & Input Guards ---
# Maximum concurrent /retrieve, /query, or /query/stream requests (low profile default: 1)
# MAX_CONCURRENT_REQUESTS=4
# Seconds to wait for a concurrency slot before returning HTTP 503
# QUEUE_TIMEOUT_S=30.0
# Comma-separated API keys required via X-API-Key header on POST endpoints (empty = auth disabled)
# API_KEYS=
# Per-caller (API key or client IP) token-bucket rate limit per minute (0 = disabled)
# RATE_LIMIT_PER_MINUTE=30
# Comma-separated allowlist of provider:model pairs (empty = DEFAULT_MODELS + LLM_PROVIDER:LLM_MODEL)
# ALLOWED_MODELS=
# Maximum allowed characters in a request query before returning HTTP 422
# MAX_QUERY_CHARS=1000

# --- Structured Logging & Observability ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
# Output format: text | json (single JSON object per line)
# LOG_FORMAT=text

# --- Streamlit UI Security & Feedback ---
# Required when binding Streamlit to a non-loopback address (e.g. 0.0.0.0)
# UI_PASSWORD=
# Directory where UI 👍/👎 feedback JSONL entries are appended
# FEEDBACK_DIR=./feedback

# --- BSB Raw Source File Paths & Data Directory ---
# Base directory for resolving relative data file paths (e.g. "../.." in Git worktrees)
BSB_DATA_DIR=.
BSB_USJ_ZIP_PATH=./bsb_usj.zip
BSB_OUTLINES_PDF_PATH=./bsb_book_outlines.pdf
BSB_TOPICAL_XLSX_PATH=./bsb_topical_index.xlsx
BSB_CONCORDANCE_XLSX_PATH=./bsb_concordance.xlsx

# --- Low-resource offline profile ---
# Uncomment these values to replace the corresponding settings above/below.
# RESOURCE_PROFILE=low
# OFFLINE_MODE=true
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:1.5b
# QDRANT_MODE=remote
# OLLAMA_BASE_URL=http://localhost:11434
# MODEL_CACHE_DIR=./.model_cache
# LLM_NUM_CTX=3072
# LLM_NUM_PREDICT=384
# LLM_NUM_THREAD=2
# CONTEXT_TOKEN_BUDGET=1600
# CONTEXT_CHUNK_TOKEN_CAP=400
# FAST_PATH_ENABLED=true
